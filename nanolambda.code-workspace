{
  "folders": [
    {
      "path": "server",
      "name": "NanoLambda Server",
    },
    {
      "path": ".",
      "name": "Root",
    },
  ],
  "settings": {
    "rust-analyzer.linkedProjects": ["server/Cargo.toml"],
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "clippy",

    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer",

    "files.associations": {
      "*.toml": "toml",
    },

    "files.exclude": {
      "**/target": true,
      "**/node_modules": true,
      "**/build": true,
    },

    "search.exclude": {
      "**/target": true,
      "**/node_modules": true,
      "**/Cargo.lock": true,
      "**/package-lock.json": true,
    },
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build",
        "type": "shell",
        "command": "cargo build",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$rustc",
      },
      {
        "label": "Build Release",
        "type": "shell",
        "command": "cargo build --release",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": "build",
        "problemMatcher": "$rustc",
      },
      {
        "label": "Test",
        "type": "shell",
        "command": "cargo test --workspace",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": "$rustc",
      },
      {
        "label": "Run Server",
        "type": "shell",
        "command": "cargo run --bin nanolambda-server",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": "none",
        "problemMatcher": "$rustc",
        "isBackground": true,
      },
      {
        "label": "Clippy",
        "type": "shell",
        "command": "cargo clippy --all-targets --all-features -- -D warnings",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": "test",
        "problemMatcher": "$rustc",
      },
      {
        "label": "Watch",
        "type": "shell",
        "command": "cargo watch -x 'check' -x 'test'",
        "options": { "cwd": "${workspaceFolder:NanoLambda Server}" },
        "group": "none",
        "isBackground": true,
        "problemMatcher": "$rustc",
      },
      {
        "label": "Pre-push Check",
        "type": "shell",
        "command": "bash scripts/pre-push-check.sh",
        "options": { "cwd": "${workspaceFolder:Root}" },
        "group": "test",
        "problemMatcher": [],
      },
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "lldb",
        "request": "launch",
        "name": "Debug Server",
        "cargo": {
          "args": [
            "build",
            "--bin=nanolambda-server",
            "--package=nanolambda-server",
          ],
          "filter": {
            "name": "nanolambda-server",
            "kind": "bin",
          },
        },
        "args": [],
        "cwd": "${workspaceFolder:NanoLambda Server}",
      },
      {
        "type": "lldb",
        "request": "launch",
        "name": "Debug CLI",
        "cargo": {
          "args": [
            "build",
            "--bin=nanolambda-cli",
            "--package=nanolambda-server",
          ],
          "filter": {
            "name": "nanolambda-cli",
            "kind": "bin",
          },
        },
        "args": [],
        "cwd": "${workspaceFolder:NanoLambda Server}",
      },
      {
        "type": "lldb",
        "request": "launch",
        "name": "Debug Tests",
        "cargo": {
          "args": ["test", "--no-run", "--package=nanolambda-server"],
          "filter": {
            "name": "nanolambda-server",
            "kind": "lib",
          },
        },
        "args": [],
        "cwd": "${workspaceFolder:NanoLambda Server}",
      },
    ],
    "compounds": [],
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "tamasfe.even-better-toml",
      "vadimcn.vscode-lldb",
      "serayuzgur.crates",
      "fill-labs.dependi",
    ],
  },
}
