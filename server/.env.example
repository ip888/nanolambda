# NanoLambda Environment Configuration

# Stripe API Keys (for payment processing)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create products/prices in Stripe Dashboard)
# These should correspond to your monthly subscription prices for each tier
STRIPE_PRICE_STARTER=price_starter_monthly_id
STRIPE_PRICE_PRO=price_pro_monthly_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_id

# Database configuration (optional - defaults to ./nanolambda.db)
# NANOLAMBDA_DB_PATH=./nanolambda.db

# Server configuration (optional - defaults shown)
# PORT=8080
# HOST=0.0.0.0

# CORS configuration (optional - defaults to allow all origins)
# Comma-separated list of allowed origins for production
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# JWT secret for user authentication (required for production)
# JWT_SECRET=your-secret-key-here

# Admin API key (required for admin endpoints)
# ADMIN_API_KEY=your-admin-key-here
