{
  "name": "nanolambda-edge",
  "version": "0.1.0",
  "description": "NanoLambda Edge - Rust-based serverless platform for Cloudflare Workers",
  "private": true,
  "scripts": {
    "build": "cargo install worker-build@0.8 && worker-build --release",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "tail": "wrangler tail"
  },
  "keywords": ["cloudflare", "workers", "serverless", "rust", "wasm"],
  "author": "NanoLambda Team",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.83.0"
  }
}
